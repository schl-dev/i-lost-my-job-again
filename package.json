{
  "name": "i-lost-my-job-again",
  "productName": "I Lost My Job (Again)",
  "version": "2.0.0",
  "description": "Jeu narratif d'entretien d'embauche : 5 entreprises, des recruteurs IA, un carnet, un CV qui progresse… et tu finis toujours par perdre le job.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "vendor": "node scripts/vendor.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win --x64 --publish never",
    "prestart": "node scripts/embed-secret.js --optional",
    "predev": "node scripts/embed-secret.js --optional",
    "predist": "node scripts/embed-secret.js",
    "installeur": "node scripts/build-installeur.js",
    "postdist": "node scripts/build-installeur.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "three": "^0.128.0"
  },
  "build": {
    "appId": "fr.schl.ilostmyjobagain",
    "productName": "I Lost My Job (Again)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "secret.js",
      "index.html",
      "vendor/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "I Lost My Job (Again)",
      "runAfterFinish": true,
      "artifactName": "ILostMyJobAgain-Setup.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "schl-dev",
        "repo": "i-lost-my-job-again"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schl-dev/i-lost-my-job-again.git"
  }
}
